-- ============================================
-- Представления (VIEW) для удобства
-- ============================================

-- Представление: товары с остатками
CREATE OR REPLACE VIEW v_products_with_stock AS
SELECT 
    p.id,
    p.sku,
    p.name,
    p.category,
    p.unit,
    p.min_stock,
    p.price,
    COALESCE(s.quantity, 0) AS quantity,
    CASE 
        WHEN COALESCE(s.quantity, 0) < p.min_stock THEN 'Низкий остаток'
        ELSE 'В наличии'
    END AS status
FROM products p
LEFT JOIN stock s ON p.id = s.product_id
ORDER BY p.name;

-- Представление: статистика по категориям
CREATE OR REPLACE VIEW v_category_stats AS
SELECT 
    category,
    COUNT(*) AS total_products,
    SUM(s.quantity * p.price) AS total_value
FROM products p
LEFT JOIN stock s ON p.id = s.product_id
GROUP BY category
ORDER BY total_value DESC;

-- ============================================
-- Триггеры (опционально)
-- ============================================

-- Триггер: автоматическое создание записи в stock при добавлении товара
DELIMITER $$
CREATE TRIGGER after_product_insert
AFTER INSERT ON products
FOR EACH ROW
BEGIN
    INSERT INTO stock (product_id, quantity) VALUES (NEW.id, 0);
END$$
DELIMITER ;

