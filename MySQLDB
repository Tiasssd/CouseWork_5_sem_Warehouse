-- Вывести последние 10 движений
SELECT 
    m.id,
    m.movement_date,
    m.type,
    p.sku,
    p.name,
    m.quantity,
    u.login
FROM movements m
JOIN products p ON m.product_id = p.id
LEFT JOIN users u ON m.user_id = u.id
ORDER BY m.movement_date DESC
LIMIT 10;

-- Общая стоимость товаров на складе
SELECT 
    SUM(s.quantity * p.price) AS total_warehouse_value
FROM stock s
JOIN products p ON s.product_id = p.id;
